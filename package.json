{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "高级软件开发技术 · Lab1 Phase 1：用 TypeScript 和面向对象设计实现 SVG 命令行编辑器。",
  "main": "dist/src/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "render:architecture": "node scripts/render-architecture.mjs",
    "build": "tsc",
    "test": "npm run build && node --test --test-reporter spec 'dist/tests/**/*.test.js'",
    "cli": "npm run build --silent && node dist/src/main.js",
    "demo": "npm run build --silent && node scripts/run-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tastezz/svg-editor.git"
  },
  "keywords": [],
  "author": "Tastezz",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.19.0",
  "bugs": {
    "url": "https://github.com/Tastezz/svg-editor/issues"
  },
  "homepage": "https://github.com/Tastezz/svg-editor#readme",
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
